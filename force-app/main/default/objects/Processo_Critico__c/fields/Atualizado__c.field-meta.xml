<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Atualizado__c</fullName>
    <description>Entra no indicador Atualidade do acervo.</description>
    <formula>AND(ISPICKVAL(Status_Registro__c, &quot;Registrado&quot;), NOT(ISBLANK(Ultima_Revisao__c)), Proxima_Revisao__c &gt;= TODAY())</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Acervo atualizado</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
