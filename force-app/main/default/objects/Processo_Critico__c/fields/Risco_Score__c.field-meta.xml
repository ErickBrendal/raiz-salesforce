<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Risco_Score__c</fullName>
    <description>Criticidade x dependencia x desatualizacao. Maximo 24. Informacao insuficiente pesa como ponto unico (nunca verde).</description>
    <externalId>false</externalId>
    <formula>CASE(TEXT(Criticidade__c), &quot;Critico&quot;, 4, &quot;Alto&quot;, 3, &quot;Medio&quot;, 2, 1) * IF(ISBLANK(Aptos_Efetivos__c), 3, IF(Aptos_Efetivos__c &lt;= 1, 3, IF(Aptos_Efetivos__c = 2, 2, 1))) * IF(Atualizado__c, 1, 2)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Score de risco</label>
    <precision>18</precision>
    <scale>0</scale>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
