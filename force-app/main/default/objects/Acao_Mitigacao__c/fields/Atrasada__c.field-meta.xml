<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Atrasada__c</fullName>
    <description>Prazo passou e a acao nao foi concluida.</description>
    <formula>AND(NOT(ISBLANK(Prazo__c)), Prazo__c &lt; TODAY(), NOT(ISPICKVAL(Status__c, &quot;Concluida&quot;)))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Atrasada</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
