<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fonte_Cobertura__c</fullName>
    <description>De onde vem o numero de aptos: Habilitacoes (evidenciado), Declarado (informado no processo) ou Sem dado.</description>
    <externalId>false</externalId>
    <formula>IF(Habilitacoes_Registradas__c &gt; 0, &quot;Habilitacoes&quot;, IF(ISBLANK(Pessoas_Aptas__c), &quot;Sem dado&quot;, &quot;Declarado&quot;))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Fonte da cobertura</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
