<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exposicao_Completa__c</fullName>
    <description>Falso quando o processo e ponto unico mas falta impacto/hora ou horas para restabelecer: a exposicao exibida esta subestimada.</description>
    <formula>OR(NOT(Ponto_Unico_de_Falha__c), AND(NOT(ISBLANK(Impacto_Hora__c)), NOT(ISBLANK(Horas_Para_Restabelecer__c))))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Exposicao completa</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
