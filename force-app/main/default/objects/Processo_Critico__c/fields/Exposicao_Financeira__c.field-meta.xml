<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exposicao_Financeira__c</fullName>
    <description>Regra 2: impacto por hora x horas para restabelecer, somente em ponto unico de falha. Veja Exposicao completa.</description>
