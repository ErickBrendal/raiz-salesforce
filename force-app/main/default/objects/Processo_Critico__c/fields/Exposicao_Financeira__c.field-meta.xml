    <formula>IF(Ponto_Unico_de_Falha__c, BLANKVALUE(Impacto_Hora__c, 0) * BLANKVALUE(Horas_Para_Restabelecer__c, 0), 0)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Exposicao financeira (R$)</label>
    <precision>18</precision>
    <scale>2</scale>
    <required>false</required>
    <trackHistory>false</trackHistory>
