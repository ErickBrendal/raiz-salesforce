<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Atrasado__c</fullName>
    <description>Data alvo passou e o plano nao foi concluido nem cancelado.</description>
    <formula>AND(NOT(ISBLANK(Data_Alvo__c)), Data_Alvo__c &lt; TODAY(), NOT(ISPICKVAL(Status__c, &quot;Concluido&quot;)), NOT(ISPICKVAL(Status__c, &quot;Cancelado&quot;)))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Atrasado</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
